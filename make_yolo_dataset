import cv2
import os
import glob
import shutil
import numpy as np

# [경로 설정] 파이썬 파일과 DAVIS 폴더가 같은 위치에 있다면 그대로 두세요.
DAVIS_ROOT = "./DAVIS"
OUTPUT_ROOT = "./yolo_davis_dataset"

def mask_to_bbox(mask_path):
    """흑백 마스크를 [x, y, w, h] 바운딩 박스로 변환"""
    mask = cv2.imread(mask_path, cv2.IMREAD_GRAYSCALE)
    if mask is None: return None
    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not contours: return None
    largest_contour = max(contours, key=cv2.contourArea)
    return list(cv2.boundingRect(largest_contour))

def prepare_yolo_folders(root):
    """Train / Val / Test 3단계 폴더 구조 생성"""
    for split in ['train', 'val', 'test']:
        os.makedirs(os.path.join(root, "images", split), exist_ok=True)
        os.makedirs(os.path.join(root, "labels", split), exist_ok=True)

def build_sequence_level_dataset():
    prepare_yolo_folders(OUTPUT_ROOT)
    
    jpeg_480p_dir = os.path.join(DAVIS_ROOT, "JPEGImages", "480p")
    if not os.path.exists(jpeg_480p_dir):
        print(f"❌ DAVIS 데이터셋 경로를 찾을 수 없습니다: {jpeg_480p_dir}")
        return
        
    # 1. 480p 폴더 내부의 모든 비디오 시퀀스(폴더) 목록 추출
    sequences = sorted([f for f in os.listdir(jpeg_480p_dir) if os.path.isdir(os.path.join(jpeg_480p_dir, f))])
    total_seqs = len(sequences)
    
    print(f"📂 DAVIS 2016 내에서 총 {total_seqs}개의 독립된 비디오 시퀀스를 발견했습니다.")
    print("🔄 데이터 누수 차단을 위해 '시퀀스(폴더) 단위' 70% : 15% : 15% 분할을 시작합니다...")

    # 2. 시퀀스 목록 자체를 무작위로 셔플 (고정 시드 사용으로 재생성 보장)
    sequences = np.array(sequences)
    np.random.seed(42)
    np.random.shuffle(sequences)
    
    # 분할 인덱스 계산 (정석 Holdout)
    idx_train = int(total_seqs * 0.7)
    idx_val = int(total_seqs * 0.85)
    
    train_seqs = sequences[:idx_train]
    val_seqs = sequences[idx_train:idx_val]
    test_seqs = sequences[idx_val:]
    
    print(f"📊 [시퀀스 배정 완료] Train: {len(train_seqs)}개 | Val: {len(val_seqs)}개 | Test: {len(test_seqs)}개")
    
    # 3. 분할된 시퀀스 별로 루프를 돌며 파일 복사 및 변환 진행
    split_mapping = {}
    for s in train_seqs: split_mapping[s] = 'train'
    for s in val_seqs: split_mapping[s] = 'val'
    for s in test_seqs: split_mapping[s] = 'test'
    
    total_images_processed = 0

    for seq in sequences:
        split = split_mapping[seq]
        
        img_dir = os.path.join(DAVIS_ROOT, "JPEGImages", "480p", seq)
        mask_dir = os.path.join(DAVIS_ROOT, "Annotations", "480p", seq)
        
        img_files = sorted(glob.glob(os.path.join(img_dir, "*.jpg")))
        mask_files = sorted(glob.glob(os.path.join(mask_dir, "*.png")))
        
        for img_path, mask_path in zip(img_files, mask_files):
            filename = os.path.basename(img_path)
            basename = os.path.splitext(filename)[0]
            
            img = cv2.imread(img_path)
            if img is None: continue
            img_h, img_w, _ = img.shape
            
            bbox = mask_to_bbox(mask_path)
            if bbox is None: continue # 누락 객체 프레임 필터링
            
            x, y, w, h = bbox
            
            # YOLO 정규화 좌표 계산
            x_center = (x + w / 2.0) / img_w
            y_center = (y + h / 2.0) / img_h
            yolo_w = w / img_w
            yolo_h = h / img_h
            
            # 목적지 경로 ('시퀀스명_파일명' 구조로 중복 방지)
            dst_img_path = os.path.join(OUTPUT_ROOT, "images", split, f"{seq}_{filename}")
            dst_txt_path = os.path.join(OUTPUT_ROOT, "labels", split, f"{seq}_{basename}.txt")
            
            # 실행: 파일 복사 및 텍스트 생성
            shutil.copy(img_path, dst_img_path)
            with open(dst_txt_path, 'w') as f:
                f.write(f"0 {x_center:.6f} {y_center:.6f} {yolo_w:.6f} {yolo_h:.6f}\n")
                
            total_images_processed += 1
            
    print("\n" + "="*50)
    print(f"🎉 [전략 B] 시퀀스 레벨 격리 데이터셋 구축 완료! -> {OUTPUT_ROOT}")
    print(f"📊 총 저장된 이미지: {total_images_processed}장")
    print(f"📊 Train  이미지 (학습용): {len(os.listdir(os.path.join(OUTPUT_ROOT, 'images', 'train')))}개")
    print(f"📊 Val    이미지 (튜닝용): {len(os.listdir(os.path.join(OUTPUT_ROOT, 'images', 'val')))}개")
    print(f"📊 Test   이미지 (평가용): {len(os.listdir(os.path.join(OUTPUT_ROOT, 'images', 'test')))}개")
    print("="*50)

if __name__ == "__main__":
    build_sequence_level_dataset()